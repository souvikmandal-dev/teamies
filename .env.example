# Public Supabase project URL and anon/publishable key; never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Alternatively set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead of ANON_KEY.
# Set only on a production deployment that is served exclusively over HTTPS.
ENABLE_HSTS=false
